{
  "name": "productshop",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-productshop": "cds watch --open productshop/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-supplier": "cds watch --open supplier/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-productlist": "cds watch --open productlist/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-supplierlist": "cds watch --open supplierlist/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/productshop",
    "app/supplier",
    "app/productlist",
    "app/supplierlist",
    "app/project1"
  ],
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "User1": {
              "password": "password",
              "roles": [
                "productmanager"
              ]
            },
            "User2": {
              "password": "Initial",
              "roles": [
                "productmanager"
              ]
            }
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "crendential": {
          "database": "db.sqlite"
        }
      }
    }
  }
}
